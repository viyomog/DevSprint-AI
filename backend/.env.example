# HireMind Backend Environment Variables Template

# 1. Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Secret Key for JWT token signing
SECRET_KEY=hiremind_super_secret_jwt_key_college_2026

# 3. Supabase Cloud PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.jpuluyhivdkvfzxmcgpq.supabase.co:5432/postgres

# 4. Supabase Credentials
SUPABASE_URL=https://jpuluyhivdkvfzxmcgpq.supabase.co
SUPABASE_KEY=your_supabase_key_here

# 5. Supabase S3 Storage Credentials
SUPABASE_S3_ACCESS_KEY=your_s3_access_key_here
SUPABASE_S3_SECRET_KEY=your_s3_secret_key_here
SUPABASE_S3_ENDPOINT=https://jpuluyhivdkvfzxmcgpq.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1

# 6. Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
